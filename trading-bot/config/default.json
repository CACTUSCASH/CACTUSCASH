{
  "exchange": {
    "id": "binance",
    "sandbox": true,
    "rateLimit": 1200
  },
  "flipper": {
    "serialPort": "/dev/ttyACM0",
    "baudRate": 115200,
    "signalProtocol": "subghz",
    "notifyOnTrade": true,
    "ledFeedback": true
  },
  "bot": {
    "symbol": "BTC/USDT",
    "timeframe": "5m",
    "strategy": "ema-crossover",
    "maxPositionPct": 0.02,
    "stopLossPct": 0.015,
    "takeProfitPct": 0.03,
    "cooldownMs": 30000,
    "paperTrading": true
  },
  "dashboard": {
    "port": 3000,
    "wsPort": 3001
  },
  "persistence": {
    "restartOnCrash": true,
    "maxRestarts": 50,
    "restartDelayMs": 5000,
    "heartbeatIntervalMs": 10000
  }
}
